<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Identity\RuleIdentitySnapshot.json">
      <LogicalName>NLISSN.ContractTests.RuleIdentitySnapshot.json</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="FsCheck.Xunit" Version="3.3.2" />
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="Xunit.Combinatorial" Version="1.7.31" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 测试并行配置来自 tests/xunit.runner.json，必须复制到输出目录才会被 xUnit 读取。 -->
    <None Include="..\xunit.runner.json" Link="xunit.runner.json"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Using Include="RoslynPrototype.Tests" />
    <ProjectReference Include="..\..\src\NLISSN.Infrastructure\Concurrency\NL.Concurrency.csproj" />
    <ProjectReference Include="..\..\src\NLISSN.Infrastructure\Workspace\NLISSN.Workspace.csproj" />
    <ProjectReference Include="..\..\src\NLISSN.Application\NLISSN.Application.csproj" />
    <ProjectReference Include="..\..\src\NLISSN\NLISSN.csproj" />
    <ProjectReference Include="..\..\src\NLCPG\NLCPG.csproj" />
    <ProjectReference Include="..\..\src\NLISSN.Core\NLISSN.Core.csproj" />
    <ProjectReference Include="..\..\src\NLISSN.Rule\Checker\NLISSN.Rule.Checker.csproj" />
    <ProjectReference Include="..\..\src\NLISSN.Rules\NLISSN.Rules.csproj" />
    <ProjectReference Include="..\NLISSN.Testing\RoslynDeletionPrototype.Testing.csproj" />
  </ItemGroup>
</Project>
