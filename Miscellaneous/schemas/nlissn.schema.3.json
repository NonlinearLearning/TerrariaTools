{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlissn.dev/schemas/nlissn.schema.3.json",
  "title": "NL unified configuration Schema 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "tool": { "enum": ["nlissn", "nlcpg"] },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "input": { "$ref": "#/$defs/input" },
    "analysis": { "$ref": "#/$defs/analysis" },
    "execution": { "$ref": "#/$defs/execution" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "logging": { "$ref": "#/$defs/logging" },
    "nlcpg": { "$ref": "#/$defs/nlcpg" }
  },
  "allOf": [
    {
      "if": { "properties": { "tool": { "const": "nlissn" } } },
      "then": {
        "required": ["runId", "input", "analysis", "execution", "artifacts"],
        "properties": { "input": { "$ref": "#/$defs/nlissnInput" } },
        "not": {
          "anyOf": [
            { "required": ["nlcpg"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "tool": { "const": "nlcpg" } } },
      "then": {
        "required": ["nlcpg"],
        "properties": { "input": { "$ref": "#/$defs/nlcpgInput" } },
        "not": {
          "anyOf": [
            { "required": ["runId"] },
            { "required": ["analysis"] },
            { "required": ["execution"] },
            { "required": ["artifacts"] },
            { "required": ["logging"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "targetFramework": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1, "default": "Debug" },
        "platform": { "type": "string", "minLength": 1, "default": "AnyCPU" },
        "restore": { "enum": ["disabled", "enabled"], "default": "disabled" },
        "generatedSources": { "enum": ["include", "exclude"], "default": "include" },
        "generators": { "enum": ["disabled", "enabled"], "default": "disabled" }
      }
    },
    "nlissnInput": {
      "allOf": [
        { "$ref": "#/$defs/input" },
        { "required": ["path"] }
      ]
    },
    "nlcpgInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetName": { "type": "string" },
        "deleteClass": { "type": "string" },
        "disabledRuleTypes": { "type": "array", "items": { "type": "string" }, "default": [] },
        "validateBindings": { "type": "boolean", "default": false },
        "deleteUnreachableMethods": { "type": "boolean", "default": false },
        "deleteUnreferencedMethods": { "type": "boolean", "default": false },
        "clearUnusedInterfaceImplementations": { "type": "boolean", "default": false },
        "privatizeInternalOnlyPublicMethods": { "type": "boolean", "default": false }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directoryMaxDegreeOfParallelism", "cpgMaxDegreeOfParallelism", "groupMaxDegreeOfParallelism", "helperMaxDegreeOfParallelism", "replayMaxDegreeOfParallelism", "maxConcurrentOperations"],
      "properties": {
        "writeBack": { "type": "boolean", "default": false },
        "skipRewrite": { "type": "boolean", "default": false },
        "directoryMaxDegreeOfParallelism": { "type": "integer", "minimum": 1 },
        "cpgMaxDegreeOfParallelism": { "type": "integer", "minimum": 1 },
        "groupMaxDegreeOfParallelism": { "type": "integer", "minimum": 1 },
        "helperMaxDegreeOfParallelism": { "type": "integer", "minimum": 1 },
        "replayMaxDegreeOfParallelism": { "type": "integer", "minimum": 1 },
        "maxConcurrentOperations": { "type": "integer", "minimum": 1 },
        "directoryParallelism": { "type": "boolean", "default": true },
        "groupParallelism": { "type": "boolean", "default": false },
        "helperParallelism": { "type": "boolean", "default": true },
        "fastDeleteClassDirectory": { "type": "boolean", "default": false },
        "filterDeleteClassFilesByTargetName": { "type": "boolean", "default": false }
      }
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean", "default": false } }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "view": { "enum": ["legacy", "readable"], "default": "legacy" }
          }
        },
        "runtimeLog": { "$ref": "#/$defs/toggle" },
        "performance": { "$ref": "#/$defs/performance" },
        "evidence": { "$ref": "#/$defs/toggle" },
        "analysisLog": { "$ref": "#/$defs/toggle" },
        "rewritePlan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["none", "capture", "replay"], "default": "none" },
            "sourceRunId": { "type": "string" }
          }
        },
        "projectJson": { "$ref": "#/$defs/projectJson" }
      }
    },
    "projectJson": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "output": { "type": "string", "minLength": 1 },
        "projectWorkerCount": { "type": "integer", "minimum": 1, "default": 12 },
        "documentShardCount": { "type": "integer", "minimum": 1, "default": 1 },
        "documentShardParallelism": { "type": "integer", "minimum": 1, "default": 1 },
        "performanceDiagnostics": { "type": "boolean", "default": false },
        "requestedCapabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "mode": { "enum": ["normal", "diagnostic", "profile", "benchmark"], "default": "normal" }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["minimal", "normal", "diagnostic", "benchmark"], "default": "normal" },
        "level": { "enum": ["error", "warn", "info", "debug", "trace"], "default": "debug" },
        "categories": { "type": "array", "items": { "type": "string" }, "default": [] },
        "events": { "type": "array", "items": { "type": "string" }, "default": [] },
        "view": { "enum": ["compact", "normal", "diagnostic", "benchmark"], "default": "normal" }
      }
    },
    "nlcpg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "view": { "$ref": "#/$defs/nlcpgView" },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "json": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "nlcpgView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["stats", "local"], "default": "stats" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "hops": { "type": "integer", "minimum": 0, "default": 1 },
        "direction": { "enum": ["both", "incoming", "outgoing"], "default": "both" },
        "edgeKinds": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["nodeId"], "properties": { "nodeId": { "type": "integer", "minimum": 0 } } },
        { "required": ["fullName"], "properties": { "fullName": { "type": "string", "minLength": 1 } } },
        { "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } }
      ]
    }
  }
}
